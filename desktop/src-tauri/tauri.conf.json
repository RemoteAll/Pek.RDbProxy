{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PekRDbProxyTool",
  "version": "0.1.0",
  "identifier": "com.peikesmart.rdbproxytool",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pek.RDbProxy 连接控制台",
        "width": 1120,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
