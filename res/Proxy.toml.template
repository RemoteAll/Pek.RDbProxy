# ─────────────────────────────────────────────────────────────────────────────
# Pek.RDbProxy 配置：**真实数据库连接串只写在这里**。
#
# 项目里只放代理连接串（不含任何真实凭据）：
#   Server=http://127.0.0.1:5599;Database=<Name>;Password=<Token>;provider=network
#
# 本文件含敏感信息，已在 .gitignore 里排除（Config/ 整个目录不入库）。
# 也可以把 Connection 写成加密值（运行 `pek-rdbproxy -encrypt "连接串"` 生成）。
# ─────────────────────────────────────────────────────────────────────────────

[Server]
# 监听地址：127.0.0.1 = 只服务本机（推荐）；要给局域网其他机器用改 0.0.0.0 并把 AllowRemote 设 true
Host = "127.0.0.1"
Port = 5599
# 是否允许非回环来源（默认 false）
AllowRemote = false

# 面板仅限本机访问（默认 false）：
#   false = 面板可远程打开，靠账号 + 页签权限控制（本机免登录，远程需登录）——开发人员用自己的账号登面板
#   true  = 面板只在回环打开，远程只能用令牌走 /Db/*（最高锁死，不需要远程看面板时用）
PanelLocalOnly = false

# ── 面板账号（对齐 Pek.RAgent：用户名 + 密码哈希 + 三种鉴权级别）──────────────
# 默认 admin/admin；首次登录后请在「设置」里改密（面板会提示）
WebUserName = "admin"
# 密码哈希（`盐:哈希`）；留空 = 启动时自动生成 admin/admin 并写入
WebPasswordHash = ""
# 鉴权级别：None（全放行）/ LocalOnly（本机免登录，默认）/ Full（一律登录）
WebAuthLevel = "LocalOnly"
# JWT 密钥（首次签发令牌时自动生成，勿手改）
JwtSecret = ""

# ── 驱动组件源（DriverStore）────────────────────────────────────────────
# 本程序内置 SQLite 与 Cargo.toml 里 driver-* 列出的驱动；其余库类型（Oracle / 达梦 /
# MongoDB / HANA / Firebird / ODBC …）首次打开数据源时自动从组件源下载 dbserver 驱动包。
# 好处：**驱动组件升级不需要重编/重发本程序**（面板「设置 → 驱动组件」可检测/下载/升级）。
[DriverStore]
# 组件源地址；留空 = 平台默认地址；填 off = 关闭联网（只用本机缓存，离线环境用）
Url = ""
# 组件源 Ed25519 公钥（hex 或 SPKI）；非空强制验签，并允许内网 http 组件源
PubKey = ""
# 组件源为 https 自签/内网 CA 时指定根证书 PEM（相对路径按程序基目录）
CaFile = ""
# 组件优先：true = 连内置驱动也强制走组件（驱动可完全跟着组件源单独升级，首次使用会联网下载）
#          false（默认）= 内置驱动优先；本机已缓存该组件时改用组件，未内置的类型仍按需下载
ComponentFirst = false
# 驱动缓存目录；留空 = Data/Drivers
CacheDir = ""

# ── 数据源（[[Databases]] 可重复；Name 唯一，忽略大小写）──────────────────────
[[Databases]]
# 项目侧连接串里的 Database=<Name>
Name = "demo"
# 真实连接串（Pek.RCode 连接串格式）：
#   SQLite   : Data Source=Data/demo.db;Provider=SQLite
#   MySQL    : Server=10.0.0.5;Port=3306;Database=demo;Uid=readonly;Pwd=secret;provider=mysql;PoolIdleTime=300
#   PostgreSQL: Server=10.0.0.5;Port=5432;Database=demo;Uid=readonly;Pwd=secret;provider=postgresql
# 建议直接给只读账号（数据库侧双重保险）
Connection = "Data Source=Data/demo.db;Provider=SQLite"
# 项目侧使用 Password=<Token>；留空 = 该项目可免令牌访问此库（仅本机时可用）
Token = "tk-demo-change-me"
# 只读模式：拒绝一切写操作（调试期强烈建议 true）
ReadOnly = true
Description = "示例数据源（SQLite）"
